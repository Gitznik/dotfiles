# Catppuccin Mocha. Click a notification to dismiss it.
font=JetBrainsMono Nerd Font 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244
border-size=2
border-radius=6
width=380
padding=12
margin=10
max-icon-size=32
default-timeout=5000

[urgency=low]
border-color=#45475a

[urgency=critical]
border-color=#fab387
default-timeout=0

# Do not disturb (dnd script, bar bell, screen sharing): hide everything, including critical.
[mode=do-not-disturb]
invisible=1
