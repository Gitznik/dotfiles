# Catppuccin Mocha. Ring always visible; mauve arc on key press, blue while verifying,
# maroon on a wrong password, peach with Caps Lock.
daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock
indicator-idle-visible

image=~/.local/share/wallpapers/topo-lock.png
scaling=fill
color=181825

font=JetBrainsMono Nerd Font
font-size=20
indicator-radius=110
indicator-thickness=6

inside-color=1e1e2ecc
inside-clear-color=1e1e2ecc
inside-caps-lock-color=1e1e2ecc
inside-ver-color=1e1e2ecc
inside-wrong-color=1e1e2ecc

ring-color=45475a
ring-clear-color=f5e0dc
ring-caps-lock-color=fab387
ring-ver-color=89b4fa
ring-wrong-color=eba0ac

key-hl-color=cba6f7
bs-hl-color=f5e0dc
caps-lock-key-hl-color=cba6f7
caps-lock-bs-hl-color=f5e0dc

line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

text-color=cdd6f4
text-clear-color=f5e0dc
text-caps-lock-color=fab387
text-ver-color=89b4fa
text-wrong-color=eba0ac

layout-bg-color=00000000
layout-border-color=00000000
layout-text-color=cdd6f4
