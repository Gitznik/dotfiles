#!/usr/bin/env bash
# Adapted from Omarchy 4.5.0 bin/omarchy-screensaver (basecamp/omarchy, MIT).
text="${XDG_CONFIG_HOME:-$HOME/.config}/screensaver/text.txt"

quit() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1
  pkill -t "${tty#/dev/}" -x ttfx 2>/dev/null
  exit 0
}
trap quit INT TERM HUP QUIT

tty=$(tty)
printf '\033]11;rgb:00/00/00\007'
stty -echo 2>/dev/null
hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1

# ttfx measures the terminal once; wait until the window has its fullscreen size.
deadline=$((SECONDS + 2))
while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do sleep 0.02; done

while true; do
  ttfx -i "$text" --frame-rate 60 --canvas-width 0 --canvas-height 0 --reuse-canvas \
    --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor &
  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    read -rsn1 -t1 && quit
  done
done
